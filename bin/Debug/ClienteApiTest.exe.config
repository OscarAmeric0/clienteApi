<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<appSettings>
	<!-- Ajustamos la URL Base para que apunte directamente al endpoint del recurso -->
	<add key="ApiBaseUrl" value="https://avihub.pesoexato.com/api/v3/" />
	<add key="SimulationToken" value="v3-demo-token" />
	<add key="AuthStrategy" value="Bearer" />
	</appSettings>
</configuration>